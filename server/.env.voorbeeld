# Instellingen voor de spelserver van Rommelblok. Kopieer dit naar .env en vul het in.
# Zet hier nooit echte wachtwoorden in de repository: alleen in .env op de VPS (die staat in .gitignore).

# Waar de server luistert (alleen op de computer zelf; nginx zet er https/wss voor)
PORT=8090
HOST=127.0.0.1
# Het pad voor WebSocket-verbindingen (nginx stuurt wss://blok.rubensrommelhoekje.nl/samen hierheen)
PAD=/samen

# Het SQLite-bestand met de gedeelde werelden (in Docker: op een volume)
DB_PAD=./data/rommelblok.db

# Welke pagina's mogen verbinden (komma's ertussen). Standaard de site (met en zonder www) en de desktop-app.
# ORIGINS=https://rubensrommelhoekje.nl,https://www.rubensrommelhoekje.nl,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Het beheerwachtwoord (minstens 12 tekens) voor /beheer/meldingen, /beheer/werelden en /beheer/wereld.
# Leeg laten = geen beheer.
BEHEER=

# Grenzen (dit zijn de standaardwaarden)
# MAX_BERICHT=16384          # bytes per bericht
# MAX_PER_SECONDE=40         # berichten per seconde (gemiddeld)
# MAX_PIEK=80                # even pieken mag tot zoveel
# MAX_ACTIES=10              # acties (breken, bouwen, ...) per seconde
# ZIN_ELKE=2                 # seconden tussen twee zinnetjes
# MAX_PER_ADRES=4            # verbindingen per IP-adres
# MAX_SPELERS=8              # spelers per wereld
# MAX_NIEUW_PER_DAG=3        # nieuwe werelden per IP-adres per dag
# MAX_WERELDEN=200           # gedeelde werelden in totaal
# STIL_SECONDEN=60           # zonder bericht gaat de verbinding dicht
# LEVENSTEKEN_SECONDEN=15    # zo vaak vraagt de server of je er nog bent
# MAX_FOUTE_CODES=8          # foute uitnodigingscodes per IP-adres per kwartier
# SERVER_STRAAL=4            # hoeveel stukken rond elke speler de server bijhoudt (water en groei)
# MAX_ACTIEF=20              # werelden die tegelijk open mogen zijn
# MAX_VERBINDINGEN=200       # verbindingen in totaal
# MAX_FOUTE_CODES_TOTAAL=200 # foute uitnodigingscodes van alle adressen samen, per 10 minuten
